# kuibit test fixture: CarpetX TSV output, second segment (output-0001).
# Recovers from the checkpoint written by carpetx_tsv.par.
# Run with 2 MPI processes:
#   mpirun -np 2 cactus_<config> carpetx_tsv_recover.par

ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    CoordinatesX
    IOUtil
"

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "presync-only"
Cactus::cctk_itlast = 6

# Tiny grid: two coarse boxes along x, plus two separate refined regions on
# level 1, so that 1D lines along x have a gap between two level-1 boxes.
CarpetX::ncells_x = 16
CarpetX::ncells_y = 1
CarpetX::ncells_z = 1
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8
CarpetX::max_num_levels = 2
CarpetX::regrid_every = 1

BoxInBox::num_regions = 2
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = -0.5
BoxInBox::radius_x_1[1] = 0.25
BoxInBox::radius_y_1[1] = 4.0
BoxInBox::radius_z_1[1] = 4.0
BoxInBox::num_levels_2 = 2
BoxInBox::position_x_2 = +0.5
BoxInBox::radius_x_2[1] = 0.25
BoxInBox::radius_y_2[1] = 4.0
BoxInBox::radius_z_2[1] = 4.0

IO::out_dir = "output-0001/carpetx_tsv"
IO::out_every = 1
IO::out_fileinfo = "all"
CarpetX::out_metadata = no

# After the restart, switch to plain headers with all iterations in one
# file. 3D TSV output is unchanged.
CarpetX::out_tsv = yes
CarpetX::out_tsv_header = "plain"
CarpetX::out_tsv_combine_iterations = yes
CarpetX::out_tsv_vars = "
    CoordinatesX::cell_coords
    BoxInBox::positions
    BoxInBox::radii
"

CarpetX::recover_method = "openpmd"
IO::recover = "autoprobe"
IO::recover_dir = "checkpoints"
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no
